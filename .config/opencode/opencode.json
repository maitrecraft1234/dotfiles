{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git push": "deny",
      "git commit": "ask"
    }
  },
  "plugin": ["opencode-gemini-auth@latest"],
  "model": "github-copilot/gpt-5-mini",
  "agent": {
    "general": {
      "mode": "subagent",
      "model": "github-copilot/gpt-5-mini"
    },
    "explore": {
      "mode": "subagent",
      "model": "github-copilot/gpt-5-mini"
    }
  }
}
